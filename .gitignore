# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*


# typescript
*.tsbuildinfo
next-env.d.ts

# Tooling
!.env.example
/playwright-report/
/test-results/
.idea/
*.iml
/.agents/
/.aws/

# Keep only the project README among root Markdown files
/*.[mM][dD]
!/README.md

# Local review notes
/docs/code-review.md

# Persistent private application data
/data/
*.sqlite
*.sqlite-shm
*.sqlite-wal

# Development-only design review artifacts
/.impeccable/
