{
    "name": "riad",
    "version": "0.1.0",
    "private": true,
    "scripts": {
        "dev": "next dev",
        "build": "next build",
        "start": "next start",
        "lint": "eslint . --no-color",
        "typegen": "next typegen && node scripts/clean-next-env.cjs",
        "check-types": "next typegen && node scripts/clean-next-env.cjs && tsc --noEmit --pretty",
        "test": "jest --runInBand",
        "test:watch": "jest --watch",
        "test:coverage": "jest --runInBand --coverage",
        "test:unit": "jest --runInBand tests/unit",
        "test:integration": "jest --runInBand tests/integration",
        "test:e2e": "next build && playwright test",
        "test:e2e:ui": "next build && playwright test --ui",
        "prepare": "husky || true",
        "prettier:check": "prettier --check \"app/**/*.{ts,tsx}\" \"components/**/*.{ts,tsx}\" \"lib/**/*.{ts,tsx}\" \"types/**/*.ts\"",
        "prettier:write": "prettier --write \"app/**/*.{ts,tsx}\" \"components/**/*.{ts,tsx}\" \"lib/**/*.{ts,tsx}\" \"types/**/*.ts\"",
        "validate": "bun run lint && bun run check-types && bun run test",
        "env:example": "ts-node --project tsconfig.scripts.json scripts/generate-env-example.ts",
        "trad": "ts-node --project tsconfig.scripts.json pull-trad.ts --min 0",
        "trad:push": "ts-node --project tsconfig.scripts.json push-trad.ts",
        "trad:missing": "node scripts/find-missing-trad.cjs",
        "test:e2e:visual": "playwright test --config playwright.visual.config.ts",
        "test:e2e:media": "playwright test --config playwright.media.config.ts",
        "staff:user": "node --experimental-strip-types --conditions=react-server scripts/staff-user.mjs",
        "test:docker:staff": "node tests/docker/staff-smoke.cjs",
        "staff:seed": "node --experimental-strip-types --conditions=react-server scripts/staff-seed.mjs",
        "test:deploy": "node --test tests/deploy/*.test.cjs"
    },
    "dependencies": {
        "better-auth": "^1.7.14",
        "clsx": "^2.1.1",
        "dotenv": "^16.6.1",
        "framer-motion": "^12.23.23",
        "next": "16.3.5",
        "next-intl": "^4.13.1",
        "node-mailjet": "^6.0.11",
        "react": "19.3.0",
        "react-dom": "19.3.0",
        "react-hot-toast": "^2.6.0",
        "react-icons": "^5.7.0",
        "server-only": "^0.0.1",
        "tailwind-merge": "^3.6.0"
    },
    "devDependencies": {
        "@commitlint/cli": "^21.2.0",
        "@commitlint/config-conventional": "^21.2.0",
        "@commitlint/cz-commitlint": "^21.2.0",
        "@next/eslint-plugin-next": "^16.2.10",
        "@playwright/test": "^1.61.1",
        "@tailwindcss/postcss": "^4.3.2",
        "@testing-library/jest-dom": "^6.9.1",
        "@testing-library/react": "^16.3.2",
        "@testing-library/user-event": "^14.6.1",
        "@types/jest": "^30.0.0",
        "@types/node": "^26.1.0",
        "@types/react": "19.3.0",
        "@types/react-dom": "19.3.0",
        "axios": "1.20.0",
        "babel-plugin-react-compiler": "^1.0.0",
        "commitizen": "^4.3.2",
        "eslint": "10.11.0",
        "eslint-config-next": "^16.2.10",
        "eslint-plugin-react-hooks": "^7.1.1",
        "husky": "^9.1.7",
        "jest": "^29.7.0",
        "jest-environment-jsdom": "^29.7.0",
        "lint-staged": "^17.0.8",
        "nock": "^13.5.6",
        "postcss": "8.5.28",
        "prettier": "^3.9.4",
        "tailwindcss": "^4.3.2",
        "ts-node": "^10.9.2",
        "typescript": "5.9.3",
        "typescript-eslint": "^8.68.0"
    },
    "author": "Biotech Dental Web Team",
    "license": "UNLICENSED",
    "engines": {
        "node": ">=22.13.0"
    },
    "lint-staged": {
        "*.{ts,tsx}": [
            "eslint --fix",
            "prettier --write"
        ]
    },
    "config": {
        "commitizen": {
            "path": "@commitlint/cz-commitlint"
        }
    }
}
